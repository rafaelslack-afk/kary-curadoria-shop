# ============================================================
# KVO — exemplo de variáveis (desenvolvimento)
# A lista completa de produção está em .env.production.example.
# Copie para .env.local e preencha. NUNCA commite valores reais.
# ============================================================

# TikTok — Pixel (navegador) + Events API (servidor)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=DB6JF1RC77UDJT303HC0
# Token da Events API: SÓ no servidor (nunca com prefixo NEXT_PUBLIC_).
TIKTOK_EVENTS_API_TOKEN=
# Opcional — só para validar no Test Events.
TIKTOK_TEST_EVENT_CODE=
